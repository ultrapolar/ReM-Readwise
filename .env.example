# ── Readwise ──────────────────────────────────────────────────────────────
# Get this token from https://readwise.io/access_token
READWISE_TOKEN=

# Which Reader documents to push to the reMarkable.
# category: pdf (default), epub, article, email, rss, ...
READWISE_CATEGORY=pdf
# Optional Reader location filter: new | later | shortlist | archive | feed
# Leave blank to include all locations.
READWISE_LOCATION=

# ── reMarkable ────────────────────────────────────────────────────────────
# Folder on the reMarkable where synced PDFs live (created if missing).
REMARKABLE_FOLDER=Readwise
# Path to the rmapi binary (bundled in the Docker image as "rmapi").
RMAPI_PATH=rmapi
# Where the reMarkable auth token is stored. Keep this on a persistent volume.
RMAPI_CONFIG=/data/rmapi.conf

# ── Sync engine ───────────────────────────────────────────────────────────
# How often the service runs a full sync cycle, in seconds (default 15 min).
SYNC_INTERVAL_SECONDS=900
# Persistent sync state (which docs are uploaded, which highlights pushed).
STATE_PATH=/data/state.json
# Rotating backups of the state file (state.json.1 = newest ... N = oldest),
# refreshed at most once per sync cycle. 0 disables backups.
STATE_BACKUPS=3
# Scratch directory for downloaded PDFs / reMarkable archives.
WORK_DIR=/data/work
# Inbox folder: drop local PDFs here to push them to the reMarkable directly.
# Use this for PDFs you UPLOADED into Reader (Reader won't serve those back).
# Their highlights round-trip to Readwise titled after the file.
INBOX_DIR=/data/inbox
# Set to 1 to log what would happen without uploading or pushing anything.
DRY_RUN=0
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Heartbeat / alerting ──────────────────────────────────────────────────
# Liveness status file, rewritten after every sync cycle (success or failure).
# Point a healthcheck or uptime monitor at it; see README "Monitoring & alerts".
STATUS_PATH=/data/status.json
# Optional Discord-compatible webhook (POSTs {"content": "..."}) that gets one
# alert when cycles keep failing and one message when sync recovers.
# Leave blank to disable alerting.
ALERT_WEBHOOK_URL=
# How many cycles must fail in a row before the alert fires.
ALERT_AFTER_FAILURES=3
